---
import { route } from "../lib/url";
import { CATEGORIES, TOTAL_HOURS } from "../lib/budget";
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Spend Your Semester</title>
    <meta
      name="description"
      content="A week has exactly 168 hours. Allocate them across sleep, study, work and everything else, and watch how little is left."
    />
  </head>
  <body>
    <nav class="site-nav" aria-label="Main">
      <div class="shell">
        <a href={route("")}>Spend Your Semester</a>
      </div>
    </nav>

    <main>
      <section class="hero">
        <div class="shell">
          <h1>Spend Your Semester</h1>
          <p class="hero-sub">
            A week has exactly {TOTAL_HOURS} hours. You think you have more free
            time than you do. Move the sliders and find out.
          </p>
        </div>
      </section>

      <section class="budget-section" aria-label="Budget tracker">
        <div class="shell">
          <div class="budget-header">
            <span class="budget-label">Weekly budget</span>
            <span class="budget-hours" data-testid="budget-used">
              0 / {TOTAL_HOURS} hrs
            </span>
          </div>
          <div class="budget-track">
            <div class="budget-fill" data-testid="budget-bar" style="width: 0%">
            </div>
          </div>
        </div>
      </section>

      <div class="shell">
        <div class="presets" role="group" aria-label="Presets">
          <button class="preset-btn" data-preset="fresh" type="button">
            Start fresh
          </button>
          <button class="preset-btn" data-preset="basics" type="button">
            The basics
          </button>
          <button class="preset-btn" data-preset="balanced" type="button">
            Balanced week
          </button>
          <button class="preset-btn" data-preset="allin" type="button">
            All-in
          </button>
        </div>

        <div class="categories">
          {
            CATEGORIES.map((cat) => (
              <div class="category-card">
                <div class="category-top">
                  <span class="category-name">
                    <span class="category-icon" aria-hidden="true">
                      {cat.icon}
                    </span>{" "}
                    {cat.label}
                  </span>
                  <span class="category-hours" data-hours-for={cat.id}>
                    0 hrs
                  </span>
                </div>
                <input
                  type="range"
                  class="category-slider"
                  min="0"
                  max={cat.max}
                  value="0"
                  step={cat.step}
                  data-testid={`slider-${cat.id}`}
                  data-category={cat.id}
                  aria-label={`${cat.label}, hours per week`}
                />
                <span class="category-detail" data-detail-for={cat.id}>
                  &nbsp;
                </span>
              </div>
            ))
          }
        </div>

        <div
          class="status-msg status-under"
          data-testid="status-message"
          role="status"
          aria-live="polite"
        >
          You have {TOTAL_HOURS} hours unallocated. Start sliding.
        </div>

        <section class="breakdown">
          <h2>Where your week goes</h2>
          <div class="breakdown-bars">
            {
              CATEGORIES.map((cat) => (
                <div class="bar-row" data-bar-for={cat.id}>
                  <span class="bar-label">{cat.label}</span>
                  <div class="bar-track">
                    <div
                      class="bar-fill"
                      style={`width: 0%; background: ${cat.colour}`}
                    />
                  </div>
                  <span class="bar-pct">0%</span>
                </div>
              ))
            }
          </div>
        </section>

        <section class="explainer">
          <h2>Why this matters</h2>
          <p>
            Most students plan their semester around classes and deadlines. They
            rarely sit down and account for all {TOTAL_HOURS} hours in a week.
            When you do, the arithmetic is unforgiving: eight hours of sleep a
            night costs 56 hours, leaving 112 before you have done a single
            thing.
          </p>
          <p>
            Add fifteen hours of classes, twenty hours of study, and basic
            self-care, and you are already past 100. The hours that feel free
            are what is left after everything else has taken its cut, and that
            number is almost always smaller than people expect.
          </p>
          <p>
            This is not a prescription. Some people thrive on six hours of
            sleep; others need nine. The point is not to optimise your week but
            to see it honestly. Once the numbers are in front of you, the
            trade-offs become real: an extra shift at work is not free, it comes
            out of something else. Knowing that before the semester starts is
            worth more than discovering it in week eight.
          </p>
        </section>
      </div>
    </main>

    <footer class="site-footer">
      <div class="shell">An interactive explainer for COMP4020, ANU, 2026.</div>
    </footer>

    <script>
      import { PRESETS, sync, type Allocations } from "../lib/budget";

      // This block is deliberately thin: read the sliders, hand them to
      // `sync`, and wire the buttons. Everything worth testing lives in
      // src/lib/budget.ts, where the typechecker and the spec can both see it.
      const sliders = [
        ...document.querySelectorAll<HTMLInputElement>("[data-category]"),
      ];

      const read = (): Allocations =>
        Object.fromEntries(
          sliders.map((slider) => [
            slider.dataset.category ?? "",
            Number(slider.value),
          ]),
        );

      const render = () => sync(document, read());

      for (const slider of sliders) {
        slider.addEventListener("input", render);
      }

      for (const button of document.querySelectorAll<HTMLButtonElement>(
        "[data-preset]",
      )) {
        button.addEventListener("click", () => {
          const values = PRESETS[button.dataset.preset ?? ""];
          if (!values) return;
          for (const slider of sliders) {
            const id = slider.dataset.category ?? "";
            if (id in values) slider.value = String(values[id]);
          }
          render();
        });
      }

      // The markup ships as an empty week; this paints whatever the browser
      // restored on a back-navigation or reload.
      render();
    </script>
  </body>
</html>
